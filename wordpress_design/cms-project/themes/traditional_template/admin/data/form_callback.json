{
  "id": "nt-form-callback",
  "action": "lead_submit",
  "submit": "Request the call",
  "class": "nt-form--dialog",
  "fields": [
    { "type": "text", "id": "callback-name",  "name": "name",  "label": "Your name", "placeholder": "Full name", "required": true },
    { "type": "tel",  "id": "callback-phone", "name": "phone", "label": "Phone",     "placeholder": "Best number to reach you", "required": true },
    {
      "type": "select",
      "id": "callback-when",
      "name": "best_time",
      "label": "Best time to call",
      "options": {
        "morning": "Morning (9am - 12pm)",
        "afternoon": "Afternoon (12pm - 4pm)",
        "evening": "Evening (4pm - 7pm)"
      }
    },
    { "type": "textarea", "id": "callback-note", "name": "message", "label": "Anything we should know?", "placeholder": "Optional" }
  ]
}

{
  "id": "nt-form-brochure",
  "action": "lead_submit",
  "submit": "Send me the brochure",
  "class": "nt-form--dialog",
  "fields": [
    { "type": "text",  "id": "brochure-name",  "name": "name",  "label": "Your name", "placeholder": "Full name", "required": true },
    { "type": "email", "id": "brochure-email", "name": "email", "label": "Email",     "placeholder": "you@example.com", "required": true },
    {
      "type": "select",
      "id": "brochure-interest",
      "name": "interest",
      "label": "What is it for?",
      "options": {
        "retail": "Buying for myself",
        "wholesale": "Wholesale or trade",
        "events": "An event or wedding",
        "franchise": "Opening a counter"
      }
    }
  ]
}

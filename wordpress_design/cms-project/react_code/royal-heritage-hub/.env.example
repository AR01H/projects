# Royal Heritage Hub — Environment Configuration
# Copy this file to .env and change the values

# ── Store Config ────────────────────────────────
# Switch between store configurations
# Options: default (Royal Heritage Hub), pickles (Pickle Paradise)
VITE_STORE_KEY=default

# ── API ──────────────────────────────────────────
# Set to false when your backend is ready
VITE_USE_MOCK=true

# Your backend API base URL
VITE_API_BASE_URL=http://localhost:4000/api

# Request timeout in milliseconds
VITE_API_TIMEOUT=15000

# ── Media ────────────────────────────────────────
# CDN for product images (leave empty to use thumbnails directly)
VITE_CDN_URL=

# Image optimization service (e.g., Cloudinary, imgix)
VITE_IMAGE_URL=

# Static assets URL
VITE_ASSETS_URL=/assets
